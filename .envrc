# direnv wiring for the guppy repository — guppy dogfoods its own
# environment contract (design §3.4): Bazel-pinned toolchains,
# project-scoped shims in .direnv/bin/, nothing on the global PATH.
# This mirrors the base-toolchain payload (internal/templates/builtin).
#
# Requirements: bazelisk provides `bazel`; the Go SDK is fetched
# hermetically by rules_go (no system Go needed for build/test).
#
# source_env pushes into each sourced file's directory while loading it,
# so the scripts below resolve the project root from GUPPY_ROOT, not
# $PWD.
GUPPY_ROOT="$PWD"
source_env tools/env/setup.sh
source_env tools/env/banner.sh
